<Window x:Class="halconDemo.QueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="记录查询" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#1E293B">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Margin="12" CornerRadius="12" Background="#F1F5F9">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.25" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <DockPanel>
            <!-- 标题栏 -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" CornerRadius="12,12,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="⌕" Foreground="#2563EB" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="记录查询" Foreground="#0F172A" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                            HorizontalAlignment="Right" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- 底部统计栏 -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" CornerRadius="0,0,12,12"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
                <DockPanel>
                    <TextBlock FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                               Text="共 128 条记录"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock FontSize="12" Foreground="#16A34A" VerticalAlignment="Center"
                                   Margin="0,0,14,0" Text="OK：112"/>
                        <TextBlock FontSize="12" Foreground="#DC2626" VerticalAlignment="Center"
                                   Text="NG：16"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 查询条件 -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="开始日期" FontSize="12" Foreground="#475569"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker Width="130" Margin="0,0,14,0"/>
                        <TextBlock Text="结束日期" FontSize="12" Foreground="#475569"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker Width="130" Margin="0,0,14,0"/>
                        <TextBlock Text="结果" FontSize="12" Foreground="#475569"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="90" Height="28" FontSize="12"
                                  VerticalContentAlignment="Center" Padding="8,0"
                                  SelectedIndex="0" Margin="0,0,14,0">
                            <ComboBoxItem Content="全部"/>
                            <ComboBoxItem Content="OK"/>
                            <ComboBoxItem Content="NG"/>
                        </ComboBox>
                        <TextBlock Text="关键字" FontSize="12" Foreground="#475569"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="150" Height="28" FontSize="12" Margin="0,0,14,0"/>
                        <Button Content="查 询" Padding="20,5" FontSize="13" FontWeight="SemiBold"
                                Margin="0,0,8,0"/>
                        <Button Content="导出" Padding="16,5" FontSize="13"
                                Style="{StaticResource NeutralButton}"/>
                    </StackPanel>
                </Border>

                <!-- 记录表格 -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10">
                    <DataGrid Margin="10" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8FAFC" BorderThickness="0"
                              HeadersVisibility="Column" FontSize="12"
                              ColumnHeaderHeight="34" RowHeight="30"
                              ItemsSource="{Binding Records}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60"/>
                            <DataGridTextColumn Header="检测时间" Binding="{Binding Time}" Width="160"/>
                            <DataGridTextColumn Header="图片文件" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="缺陷数量" Binding="{Binding DefectCount}" Width="90"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="80"/>
                            <DataGridTextColumn Header="耗时 (ms)" Binding="{Binding Elapsed}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
