<Window x:Class="halconDemo.CommunicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="通讯配置" Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#1E293B">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Margin="12" CornerRadius="12" Background="#F1F5F9">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.25" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <DockPanel>
            <!-- 标题栏 -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" CornerRadius="12,12,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="⇄" Foreground="#2563EB" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="通讯配置" Foreground="#0F172A" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                            HorizontalAlignment="Right" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：连接设置 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="连接设置" FontSize="15" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,0,0,10"/>

                            <TextBlock Text="协议类型" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ProtocolBox" Height="32" FontSize="13"
                                      VerticalContentAlignment="Center" Padding="8,0"
                                      SelectionChanged="ProtocolBox_SelectionChanged">
                                <ComboBoxItem Content="TCP 客户端" IsSelected="True"/>
                                <ComboBoxItem Content="TCP 服务端"/>
                                <ComboBoxItem Content="串口 (RS232)"/>
                            </ComboBox>

                            <!-- TCP 参数 -->
                            <StackPanel x:Name="TcpPanel" Margin="0,12,0,0">
                                <TextBlock Text="IP 地址" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="127.0.0.1" Height="32" FontSize="13"/>
                                <TextBlock Text="端口" FontSize="12" Foreground="#475569" Margin="0,10,0,4"/>
                                <TextBox Text="5000" Height="32" FontSize="13"/>
                            </StackPanel>

                            <!-- 串口参数 -->
                            <StackPanel x:Name="SerialPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock Text="串口号" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox Height="32" FontSize="13" VerticalContentAlignment="Center"
                                          Padding="8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="COM1"/>
                                    <ComboBoxItem Content="COM2"/>
                                    <ComboBoxItem Content="COM3"/>
                                    <ComboBoxItem Content="COM4"/>
                                </ComboBox>
                                <TextBlock Text="波特率" FontSize="12" Foreground="#475569" Margin="0,10,0,4"/>
                                <ComboBox Height="32" FontSize="13" VerticalContentAlignment="Center"
                                          Padding="8,0" SelectedIndex="3">
                                    <ComboBoxItem Content="1200"/>
                                    <ComboBoxItem Content="2400"/>
                                    <ComboBoxItem Content="4800"/>
                                    <ComboBoxItem Content="9600"/>
                                    <ComboBoxItem Content="19200"/>
                                    <ComboBoxItem Content="38400"/>
                                    <ComboBoxItem Content="57600"/>
                                    <ComboBoxItem Content="115200"/>
                                </ComboBox>
                                <TextBlock Text="数据位" FontSize="12" Foreground="#475569" Margin="0,10,0,4"/>
                                <ComboBox Height="32" FontSize="13" VerticalContentAlignment="Center"
                                          Padding="8,0" SelectedIndex="1">
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                </ComboBox>
                                <TextBlock Text="校验位" FontSize="12" Foreground="#475569" Margin="0,10,0,4"/>
                                <ComboBox Height="32" FontSize="13" VerticalContentAlignment="Center"
                                          Padding="8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="无"/>
                                    <ComboBoxItem Content="奇校验"/>
                                    <ComboBoxItem Content="偶校验"/>
                                </ComboBox>
                                <TextBlock Text="停止位" FontSize="12" Foreground="#475569" Margin="0,10,0,4"/>
                                <ComboBox Height="32" FontSize="13" VerticalContentAlignment="Center"
                                          Padding="8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="1.5"/>
                                    <ComboBoxItem Content="2"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 状态 + 连接按钮 -->
                            <DockPanel Margin="0,18,0,10">
                                <Ellipse Width="10" Height="10" Fill="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBlock Text="未连接" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </DockPanel>
                            <Button Content="连 接" Height="36" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- 右：收发区 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <!-- 接收区 -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="10">
                        <DockPanel Margin="12">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="接收区" FontWeight="Bold" Foreground="#0F172A"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <CheckBox Content="HEX 显示" FontSize="12" VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                    <CheckBox Content="自动换行" FontSize="12" VerticalAlignment="Center"
                                              Margin="0,0,10,0" IsChecked="True"/>
                                    <Button Content="清空" Padding="10,3" Style="{StaticResource NeutralButton}"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                                     FontFamily="Consolas" Background="#F8FAFC"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="等待数据…"/>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <!-- 发送区 -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="10">
                        <DockPanel Margin="12">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="发送区" FontWeight="Bold" Foreground="#0F172A"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <CheckBox Content="HEX 发送" FontSize="12" VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                    <CheckBox Content="追加换行" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12"
                                     FontFamily="Consolas" Background="#F8FAFC"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="已发送 0 字节" FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center"/>
                                <Button Content="发 送" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Padding="24,6" FontSize="13" FontWeight="SemiBold"/>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
