<Window x:Class="halconDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:halconDemo"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="HALCON 视觉识别平台" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#1E293B"
        StateChanged="MainWindow_StateChanged">

    <!-- 无边框 + 透明背景，用 WindowChrome 保留调整大小/贴靠功能 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 圆角根容器：Margin 留给投影，最大化时由代码置 0 -->
    <Border x:Name="RootBorder" Margin="12" CornerRadius="12" Background="#F1F5F9">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.25" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <DockPanel>
            <!-- 自定义标题栏 -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" CornerRadius="12,12,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="◉" Foreground="#2563EB" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="HALCON 视觉识别平台" Foreground="#0F172A" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource TitleBarButton}"
                                Click="Minimize_Click"/>
                        <Button Content="▢" Style="{StaticResource TitleBarButton}"
                                Click="Maximize_Click"/>
                        <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 工具栏 -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="14,10"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="加载算法文件" Padding="16,7" Margin="0,0,10,0"
                                Command="{Binding LoadAlgorithmCommand}" FontSize="13"/>
                        <Button Content="执行识别" Padding="16,7" Margin="0,0,10,0"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding ExecuteCommand}" FontSize="13"/>
                        <Button Content="重置" Padding="16,7" Margin="0,0,10,0"
                                Style="{StaticResource NeutralButton}"
                                Command="{Binding ResetCommand}" FontSize="13"/>
                        <Button Content="通讯配置" Padding="16,7" Margin="0,0,10,0"
                                Style="{StaticResource NeutralButton}"
                                Click="OpenCommunication_Click" FontSize="13"/>
                        <Button Content="记录查询" Padding="16,7"
                                Style="{StaticResource NeutralButton}"
                                Click="OpenQuery_Click" FontSize="13"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="#64748B" FontSize="12"
                               Text="{Binding AlgorithmPath, StringFormat=算法文件: {0}}"/>
                </DockPanel>
            </Border>

            <!-- 底部状态栏 -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" CornerRadius="0,0,12,12"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6">
                <DockPanel>
                    <TextBlock FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                               Text="{Binding AlgorithmName, StringFormat=算法: {0}}"/>
                    <TextBlock FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Text="{Binding Status, StringFormat=状态: {0}}"/>
                </DockPanel>
            </Border>

            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="300"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- 左：输入参数 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="输入参数" FontSize="15" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,0,0,8"/>

                            <!-- 图片序列 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,4,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="图片序列" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="浏览…" Padding="12,5"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.BrowseImageFolderCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBox Text="{Binding ImageFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                            Command="{Binding DataContext.ApplyImageFolderCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="◀ 上一张" Padding="12,5"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.PrevImageCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button DockPanel.Dock="Right" Content="下一张 ▶" Padding="12,5"
                                                Command="{Binding DataContext.NextImageCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ImagePosition}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding CurrentImageFile}" Foreground="#334155" FontSize="11"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="控制参数" FontWeight="SemiBold" Foreground="#334155" Margin="0,12,0,6"/>
                            <ItemsControl ItemsSource="{Binding InputControlParams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="150"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- 右：结果 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="300"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="170"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                            Background="#0B1220">
                        <Grid>
                            <TextBlock Text="识别结果" Foreground="#94A3B8" FontSize="12" Margin="12,8"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <Image Source="{Binding ResultImage}" Margin="10" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- OK/NG 判定标签：识别后显示在右上角 -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16"
                                    Padding="16,8" CornerRadius="8"
                                    Background="{Binding JudgeBackground}"
                                    Visibility="{Binding JudgeVisibility}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="12" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding JudgeText}" FontSize="28" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="10">
                            <DockPanel Margin="10">
                                <TextBlock DockPanel.Dock="Top" Text="历史记录" FontWeight="Bold"
                                           Foreground="#0F172A" Margin="0,0,0,6"/>
                                <ListBox ItemsSource="{Binding HistoryRecords}" FontSize="11">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="{Binding Time}" Foreground="#94A3B8"
                                                           Width="62" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="#334155"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DefectCount,
                                                           StringFormat={}{0} 处}" Width="44"
                                                           Foreground="#64748B" TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Right"/>
                                                <TextBlock Text="{Binding Result}"
                                                           Foreground="{Binding ResultBrush}"
                                                           FontWeight="Bold" Width="30"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Right"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="10">
                            <DockPanel Margin="10">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="运行日志" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="清空"
                                            Padding="10,3" Style="{StaticResource NeutralButton}"
                                            Command="{Binding ClearLogsCommand}"/>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Logs}" FontSize="11">
                                    <!-- 每行用只读 TextBox 渲染，可选中并用 Ctrl+C 复制 -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
